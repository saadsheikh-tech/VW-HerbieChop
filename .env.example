# Copy to .env and fill in. Everything is optional.
ANTHROPIC_API_KEY=
# Optional model override (defaults: gemini-3.5-flash-lite or claude-opus-5-5)
HERBIE_MODEL=
# Set to "overpass" for live OpenStreetMap landmarks (falls back to the cache on errors)
HERBIE_POI_SOURCE=
# Gemini (used if set; default model gemini-3.5-flash-lite)
GEMINI_API_KEY=
# Google Maps Platform key with the Street View Static API enabled (optional, for real windscreen imagery)
GOOGLE_MAPS_API_KEY=
# Read-only Google Calendar: Settings → your calendar → Integrate calendar → "Secret address in iCal format"
GOOGLE_CALENDAR_ICS_URL=
# Only needed when hosting the cockpit somewhere other than localhost (stadiamaps.com, free tier)
STADIA_API_KEY=
